# ============================================
# DOCKERFILE PHP 7.4 - VPS LEGACY (bind mount)
# Producción: /var/www/apidian (docker-compose.yml)
#
# IMPORTANTE:
# - Este Dockerfile es SOLO para el VPS legacy.
# - NO copia el código dentro de la imagen ni usa entrypoint:
#   el compose monta ./:/var/www/html y el arranque sigue siendo php-fpm.
# - Para Dokploy usar docker/php/Dockerfile (con entrypoint y COPY).
#
# SEGURIDAD - PHP2Shell (CVE-2026-109618 / CVE-2026-109619):
# PHP 7.4 está EOL, pero el backport oficial de esta corrección existe
# para la rama 7.4. Imagen fijada por digest para build reproducible.
# Verificar: php -i | grep max_multipart_body_parts
# ============================================
FROM ghcr.io/mpyw/php-eol-cve-2026-109618-109619:7.4-fpm@sha256:e7387ea53ae2a329ee2a4289dba3b77047e913e0e93ea405e8a999dc62010332

# Debian bullseye está EOL: sus repos están en archive.debian.org.
# Se incluye bullseye-security para que los paquetes -dev coincidan
# con los +deb11uN que trae la imagen base.
RUN printf '%s\n' \
        'deb http://archive.debian.org/debian bullseye main' \
        'deb http://archive.debian.org/debian bullseye-updates main' \
        'deb http://archive.debian.org/debian-security bullseye-security main' \
        > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources \
    && printf 'Acquire::Check-Valid-Until "false";\nAcquire::AllowInsecureRepositories "true";\n' > /etc/apt/apt.conf.d/99archive

# Dependencias del sistema (las mismas del Dockerfile 7.3 original + pkg-config)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libicu-dev \
    libc-client-dev \
    libkrb5-dev \
    zip \
    unzip \
    libssl-dev \
    pkg-config \
    libmagickwand-dev \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Extensiones PHP (mismas del 7.3).
# PHP 7.4+: GD usa --with-freetype/--with-jpeg (los *-dir ya no existen).
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-configure imap --with-kerberos --with-imap-ssl \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        mysqli \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        soap \
        xml \
        intl \
        imap \
        opcache

# imagick via PECL (misma versión que en 7.3)
RUN pecl install imagick-3.4.4 && docker-php-ext-enable imagick

# Composer 2.2 (el mismo que usa producción)
COPY --from=composer:2.2 /usr/bin/composer /usr/bin/composer

# Evitar problemas de plataforma
RUN composer config --global platform-check false

# Configuración PHP (idéntica a producción + hardening del CVE)
RUN echo "upload_max_filesize=100M" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "post_max_size=100M" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "memory_limit=1024M" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "max_execution_time=300" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "max_input_vars=3000" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "expose_php=Off" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "session.upload_progress.enabled=0" >> /usr/local/etc/php/conf.d/custom.ini

# OPcache
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=512" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=64" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.revalidate_freq=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.fast_shutdown=1" >> /usr/local/etc/php/conf.d/opcache.ini

# realpath cache
RUN echo "realpath_cache_size=4096K" >> /usr/local/etc/php/conf.d/custom.ini \
    && echo "realpath_cache_ttl=600" >> /usr/local/etc/php/conf.d/custom.ini

# PHP-FPM (mismos valores que producción)
RUN echo "[www]" > /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm = dynamic" >> /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm.max_children = 50" >> /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm.start_servers = 10" >> /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm.min_spare_servers = 5" >> /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm.max_spare_servers = 15" >> /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm.max_requests = 1000" >> /usr/local/etc/php-fpm.d/zz-performance.conf \
    && echo "pm.process_idle_timeout = 60s" >> /usr/local/etc/php-fpm.d/zz-performance.conf

# Timezone Colombia
RUN echo "date.timezone = America/Bogota" >> /usr/local/etc/php/conf.d/custom.ini

WORKDIR /var/www/html
